# KloudRecon web — LOCAL settings. Copy to `.env.local` (never commit it).
# In production these come from GitHub repository variables (infra guide Part D1).

# "/api" uses the Vite dev proxy to http://localhost:8000
VITE_API_BASE_URL=
# dev | local | entra: must match AUTH_MODE in backend/.env
VITE_AUTH_MODE=dev

# Entra External ID (only when VITE_AUTH_MODE=entra)
VITE_ENTRA_SPA_CLIENT_ID=
VITE_ENTRA_TENANT_SUBDOMAIN=
VITE_ENTRA_API_SCOPE=api://kloudrecon-api/access_as_user

VITE_APPINSIGHTS_CONNECTION_STRING=

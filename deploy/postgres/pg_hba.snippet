# Put this line at the TOP of /etc/postgresql/16/main/pg_hba.conf so it matches first:
#   sudo sed -i '1i local   kloudrecon   kloudrecon_app,kloudrecon_owner   peer map=kloudrecon' /etc/postgresql/16/main/pg_hba.conf
# TYPE  DATABASE     USER                              METHOD
local   kloudrecon   kloudrecon_app,kloudrecon_owner   peer map=kloudrecon

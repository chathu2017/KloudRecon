# KloudRecon backend — LOCAL development settings. Copy to `.env` (never commit `.env`).
# Production values live in /etc/kloudrecon/kloudrecon.env (see deploy/env/kloudrecon.env.example).

ENV=local
# dev   = pick a seeded account, no password (tests and E2E use this)
# local = real sign-in: one-time email codes, owner password + code (decision 0047)
# entra = Microsoft Entra External ID
AUTH_MODE=dev
LOG_LEVEL=INFO
LOG_FORMAT=console

# The app connects as kloudrecon_app (non-superuser) so Row-Level Security is enforced locally.
# Migrations run as the container superuser, which owns the tables (like kloudrecon_owner in prod).
DATABASE_URL=postgresql+psycopg://kloudrecon_app:kloudrecon_app@localhost:5432/kloudrecon
DATABASE_MIGRATION_URL=postgresql+psycopg://kloudrecon:kloudrecon@localhost:5432/kloudrecon
# Used by pytest (tests create their own schema here).
TEST_DATABASE_URL=postgresql+psycopg://kloudrecon:kloudrecon@localhost:5432/kloudrecon_test

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
BOOTSTRAP_OWNER_EMAILS=owner@local.test

# Dev login token signing key (AUTH_MODE=dev only; refused when ENV=prod).
DEV_AUTH_SECRET=local-dev-only-change-me-0123456789abcdef

# Real sign-in (only when AUTH_MODE=local). Set the owner password with:
#   python -m kloudrecon.cli set-owner-password <email>
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=30
AUTH_SESSION_HOURS=12
# Optional "Continue with Google / Microsoft": the buttons work once id and secret are set.
# Redirect URI to register: <PUBLIC_API_URL>/api/v1/auth/sso/<google|microsoft>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# true: a provider sign-in is still confirmed with an emailed one-time code
SSO_REQUIRE_OTP=true

# Entra External ID (only when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=api://kloudrecon-api

# Secrets: encrypted file under backend/.local-secrets/
SECRET_STORE=local
KEY_VAULT_URL=

# Blob: Azurite from docker-compose.dev.yml (well-known public development key)
BLOB_MODE=azurite
STORAGE_ACCOUNT_URL=
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Email: Mailpit (UI at http://localhost:8025)
EMAIL_MODE=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
ACS_ENDPOINT=
# Azure Communication Services with a connection string (integrations/communication_email.py):
# set EMAIL_MODE=acs, paste the connection string here and use a sender on your verified domain.
ACS_CONNECTION_STRING=
EMAIL_SENDER=donotreply@azurerec.kloudschool.com
EMAIL_SENDER_NAME=KloudRecon

# AI: mock (deterministic) or azure (uses az login / DefaultAzureCredential)
AI_MODE=mock
AOAI_ENDPOINT=
AOAI_DEPLOYMENT_MAIN=gpt-main
AOAI_DEPLOYMENT_MINI=gpt-mini
AOAI_API_VERSION=
# USD per 1M tokens for per-org AI cost tracking (owner console); set to your deployments' prices
AI_PRICE_MAIN_INPUT=2.50
AI_PRICE_MAIN_OUTPUT=10.00
AI_PRICE_MINI_INPUT=0.15
AI_PRICE_MINI_OUTPUT=0.60

# PDF reports: playwright (run `playwright install chromium` once) or minipdf (text-only)
REPORT_RENDERER=playwright
REPORT_LINK_MINUTES=15

APPLICATIONINSIGHTS_CONNECTION_STRING=

# Requests per client IP and per user (production: 300/minute). Higher locally for E2E and
# scripts/perf_check.py.
RATE_LIMIT_DEFAULT=3000/minute
WORKER_CONCURRENCY=2
RUN_SCHEDULER=true
DEMO_MODE=true
# FinOps prices: retail (Azure Retail Prices API, cached) or static (built-in catalog, offline)
PRICES_MODE=retail
PRICES_CACHE_DAYS=7
# Billing: manual (owner assigns plans) | stripe | paddle. Provider keys go into the SecretStore:
#   python -m kloudrecon.cli billing-secret stripe-api-key   (never into this file)
BILLING_PROVIDER=manual
BILLING_GRACE_DAYS=7
BILLING_SANDBOX=false
